                      LogicalName="GoblinStronghold.Simulation.Content.materials.json" />
    <EmbeddedResource Include="Content\terrain-modifications.json"
                      LogicalName="GoblinStronghold.Simulation.Content.terrain-modifications.json" />
    <EmbeddedResource Include="Content\workshops.json"
                      LogicalName="GoblinStronghold.Simulation.Content.workshops.json" />
    <EmbeddedResource Include="Localization\en\interface.json"
                      LogicalName="GoblinStronghold.Simulation.Localization.en.interface.json" />
